# Everything ignored here is regenerated by ./rocq.sh, see readme.md, but Generated/

# dune builds the proofs out of tree, so this one directory holds every artifact of the build
/_build/

# ... except that a Rocq IDE with a local installation compiles in place, next to the sources
*.vo
*.vok
*.vos
*.vio
*.glob
.*.aux

# caches of the arithmetic decision procedures (lia, nia, nra, csdp)
*.cache

# written by the frontend's RocqOracleTests, a build product like those above; run it before ./rocq.sh
/theories/Generated/
